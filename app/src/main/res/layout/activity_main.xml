<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollViewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header bar: gear + title + C/F toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="32dp"
            android:paddingBottom="12dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@color/primary">

            <!-- Settings icon (top-left) -->
            <ImageView
                android:id="@+id/imageViewSettings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="Settings"
                android:padding="4dp" />

            <!-- App title -->
            <TextView
                android:id="@+id/textViewAppTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Weatherly"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginStart="12dp" />

            <!-- C/F toggle -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchTemperatureUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="°F"
                android:textColor="@color/white"
                app:thumbTint="@color/white"
                app:trackTint="@color/white" />
        </LinearLayout>

        <!-- Main weather section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            android:gravity="center_horizontal">

            <!-- City -->
            <TextView
                android:id="@+id/textViewCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mumbai"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <!-- Weather icon -->
            <TextView
                android:id="@+id/textViewWeatherIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⛅"
                android:textSize="72sp"
                android:layout_marginBottom="8dp" />

            <!-- Temperature -->
            <TextView
                android:id="@+id/textViewTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="29°C"
                android:textSize="56sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <!-- Condition -->
            <TextView
                android:id="@+id/textViewCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Partly Cloudy"
                android:textSize="18sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="24dp" />
            <!-- Weather status (icon + text) -->
            <TextView
                android:id="@+id/textViewWeatherStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⛅ Partly Cloudy"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="24dp" />
            <!-- Weather details grid -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="16dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="16dp"
                    android:background="@color/card_background">

                    <!-- Feels like -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Feels like"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/textViewFeelsLike"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="31°C"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:gravity="end" />

                    <!-- Humidity -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Humidity"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/textViewHumidity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="72%"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:gravity="end"
                        android:layout_marginTop="12dp" />

                    <!-- Wind -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Wind"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/textViewWind"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="14 km/h"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:gravity="end"
                        android:layout_marginTop="12dp" />

                    <!-- Sunrise -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Sunrise"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/textViewSunrise"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="6:25 AM"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:gravity="end"
                        android:layout_marginTop="12dp" />

                    <!-- Sunset -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Sunset"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/textViewSunset"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="6:18 PM"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:gravity="end"
                        android:layout_marginTop="12dp" />

                </GridLayout>
            </androidx.cardview.widget.CardView>

            <!-- Summary card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@color/card_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Today's summary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/textViewSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Warm and humid throughout the day with partly cloudy skies."
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonOpenCities"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="@string/open_cities"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:cornerRadius="26dp"
                app:backgroundTint="@color/button_cities" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonOpenForecast"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/open_forecast"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:cornerRadius="26dp"
                app:backgroundTint="@color/button_forecast" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>