# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
*/build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
# Except keep .idea/misc.xml and .idea/vcs.xml if you want, but generally:
# .idea/ is ignored completely by the block above

# Keystore files
*.jks
*.keystore

# External native build folder
.externalNativeBuild/
.cxx/

# OS generated files
.DS_Store
Thumbs.db

# Optional: Android Studio profiler
*.hprof